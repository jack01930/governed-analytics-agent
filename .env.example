# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=8501

# PostgreSQL (local Docker Compose values only)
POSTGRES_DB=governed_analytics
POSTGRES_USER=governed_analytics
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+asyncpg://governed_analytics:change-me-for-local-development@127.0.0.1:5432/governed_analytics

# OpenAI-compatible model adapter
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen3.7-plus
EVAL_MODEL_NAME=qwen3.7-plus-2026-05-26

# Agent execution budgets
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=20
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_COST_CNY=0.30

# Optional observability integration
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
